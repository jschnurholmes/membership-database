%nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.fixed-top
  .container-fluid
    %a.navbar-brand{href: root_path} CD*NY Membership Database
    %button.navbar-toggler{"aria-controls" => "navbarNav", "aria-expanded" => "false", "aria-label" => "Toggle navigation", "data-bs-target" => "#navbarNav", "data-bs-toggle" => "collapse", type: "button"}
      %span.navbar-toggler-icon
    #navbarNav.collapse.navbar-collapse
      %ul.navbar-nav.me-auto.mb-2.mb-lg-0
        %li.nav-item
          = nav_link 'Memberships', memberships_path, 'memberships'
        %li.nav-item
          = nav_link 'People', people_path, 'people'
        %li.nav-item.dropdown
          %a.nav-link.dropdown-toggle#reportsDropdown{class: ('active' if nav_section_active?('reports')), "aria-expanded" => "false", "data-bs-toggle" => "dropdown", href: "#", role: "button"}
            Reports
          %ul.dropdown-menu{"aria-labelledby" => "reportsDropdown"}
            %li
              = link_to 'List Reports', reports_path, class: 'dropdown-item'
            %li
              %hr.dropdown-divider
            - Reports::Definition.all.each do |report|
              %li
                = report_menu_link(report, 'dropdown-item')
      .d-flex
        = link_to t('.sign_out', default: t("helpers.links.sign_out", default: 'Sign Out')), destroy_user_session_path, method: :delete, data: { confirm: t('.confirm', default: t("helpers.links.confirm", default: 'Are you sure?')) }, class: 'btn btn-danger'
