.content-header
  %h1
    = t '.title', :default => 'Reports'

%ul.nav.nav-pills.flex-column
  - Reports::Definition.all.each do |report|
    %li.nav-item
      = report_menu_link(report, 'nav-link')

%h4 Members: #{Person.active_on(Organization.today).count}
.membership-types
  - counts = Person.count_by_membership_type
  -MembershipType.all.each do |mt|
    -cnt = counts.fetch(mt.id, 0)
    - if cnt > 0
      .membership-type{ style: 'float: left' }
        =  mt.name + ":" + cnt.to_s
