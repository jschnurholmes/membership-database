.form-group.row
  = f.select(:type_id, PhoneType.all.collect { |type| [type.name, type.id] }, {}, :class => 'form-control')
  = f.text_field :phone_number, :class => 'text-field form-control', :type => 'tel', :placeholder => '(718) 555-5555'
  = f.hidden_field :_destroy
  = link_to '#', :class => 'btn btn-danger btn-xs _remove_field' do
    %span{class: 'glyphicon glyphicon-minus'}