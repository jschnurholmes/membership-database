.form-group
  = f.select(:type_id, PhoneType.all.collect { |type| [type.name, type.id] }, {}, :class => 'form-select')
  = f.text_field :phone_number, :class => 'text-field form-control', :type => 'tel', :placeholder => '(718) 555-5555'
  = f.hidden_field :_destroy
  = link_to '#', :class => 'btn btn-danger btn-sm _remove_field', 'aria-label' => 'Remove phone number' do
    %span{class: 'bi bi-dash-lg', 'aria-hidden' => 'true'}