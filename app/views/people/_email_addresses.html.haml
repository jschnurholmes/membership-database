.form-group.row
  = f.select(:type_id, EmailType.all.collect { |type| [type.name, type.id] }, {}, :class => 'form-control')
  = f.text_field :email, :class => 'text-field form-control', :type => 'email', :placeholder => 'user@example.com'
  = f.hidden_field :_destroy
  = link_to '#', :class => 'btn btn-danger btn-xs _remove_field' do
    %span{class: 'glyphicon glyphicon-minus'}