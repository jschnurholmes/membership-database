- current_and_potential_members.each do |person|
  .form-check.col-md-8{class: person.tags.where.not(color: nil).map{|tag| "person-tag-#{tag.name}"}}
    = check_box_tag 'membership[member_ids][]', person.id, @membership.members.include?(person), id: "person_#{person.id}", class: 'form-check-input'
    = label_tag "person_#{person.id}", person.sortable_name + (person.preferred_name.present? ? " (#{person.preferred_name})" : ''), class: 'form-check-label'
