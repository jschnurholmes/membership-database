- model_class = Membership
.content-header
  %h1
    =t '.title', :default => model_class.model_name.human.pluralize.titleize
    = "(#{Person.active_on(Organization.today).count} Members)"
    = link_to t('.new', :default => t("helpers.links.new")), new_membership_path, :class => 'btn btn-primary'

= render 'application/pagination', pagy: @pagy

%table.table.table-striped
  %thead
    %tr
      %th= sort_link @q, :id, model_class.human_attribute_name(:id), page: nil
      %th= sort_link @q, :membership_type_id, model_class.human_attribute_name(:membership_type_id), page: nil
      %th= sort_link @q, :membership_period_id, model_class.human_attribute_name(:membership_period_id), page: nil
      %th= sort_link @q, :member_names, model_class.human_attribute_name(:member_names), page: nil
      %th= sort_link @q, :mailing_preference, model_class.human_attribute_name(:mailing_preference), page: nil
      %th=t '.actions', :default => t("helpers.actions")
  %tbody
    - @memberships.each do |membership|
      %tr
        %td= link_to membership.id, membership_path(membership)
        %td= membership.membership_type
        %td= membership.membership_periods.latest
        %td= raw member_name_links(membership.members)
        %td= membership.mailing_preference
        %td
          = link_to t('.renew', :default => t("helpers.links.renew")), renew_membership_path(membership), class: 'btn btn-sm btn-success', method: :post, :data => { :confirm => t('.confirm', :default => t('helpers.links.confirm', :default => "Are you sure?")) }
          = link_to t('.edit', :default => t("helpers.links.edit")), edit_membership_path(membership), :class => 'btn btn-sm btn-primary'
          = link_to t('.destroy', :default => t("helpers.links.destroy")), membership_path(membership), :method => :delete, :data => { :confirm => t('.confirm', :default => t("helpers.links.confirm", :default => 'Are you sure?')) }, :class => 'btn btn-sm btn-danger'

= render 'application/pagination', pagy: @pagy

= link_to t('.new', :default => t("helpers.links.new")), new_membership_path, :class => 'btn btn-primary'
