#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

AWS_REGION=us-east-1
AWS_ACCOUNT=717610106072
ECR_URI="$AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com/cdny-members"
ECS_CLUSTER=cdny-ecs-cluster
ECS_SERVICE=cdny-members
TASK_FAMILY=cdny-members
ORIGIN_REF=origin/master

COMMAND="${1:-all}"
FORCE=false
[[ "${2:-}" == "--force" ]] && FORCE=true

TAG="manual-$(git rev-parse --short HEAD)"
IMAGE="$ECR_URI:$TAG"

check_clean_tree() {
  if [[ "$FORCE" != true && -n "$(git status --porcelain)" ]]; then
    echo "Working tree has uncommitted changes - the tag ($TAG) wouldn't match what's actually built." >&2
    echo "Commit first, or re-run with --force to build anyway." >&2
    exit 1
  fi
}

# Deliberately not bypassed by --force: releasing code that isn't on origin/master
# always warrants a conscious decision.
check_origin_master() {
  echo "Fetching $ORIGIN_REF"
  if ! git fetch --quiet origin master; then
    echo "Could not fetch from origin - unable to confirm HEAD matches $ORIGIN_REF." >&2
    exit 1
  fi

  local origin_sha
  if ! origin_sha=$(git rev-parse --verify --quiet "$ORIGIN_REF"); then
    echo "Could not resolve $ORIGIN_REF - unable to confirm what HEAD should match." >&2
    exit 1
  fi

  [[ "$(git rev-parse HEAD)" == "$origin_sha" ]] && return 0

  local ahead behind relation
  ahead=$(git rev-list --count "$ORIGIN_REF..HEAD")
  behind=$(git rev-list --count "HEAD..$ORIGIN_REF")
  if (( ahead > 0 && behind > 0 )); then
    relation="has diverged from $ORIGIN_REF ($ahead ahead, $behind behind)"
  elif (( ahead > 0 )); then
    relation="is $ahead commit(s) ahead of $ORIGIN_REF"
  else
    relation="is $behind commit(s) behind $ORIGIN_REF"
  fi

  echo "HEAD $relation." >&2
  echo "Releasing $TAG would put code that isn't on $ORIGIN_REF into production." >&2

  if [[ ! -t 0 ]]; then
    echo "Not running interactively - cannot ask for confirmation. Aborting." >&2
    exit 1
  fi

  local reply
  read -r -p "Continue anyway? (Y/n) " reply
  case "$reply" in
    [Yy]|[Yy][Ee][Ss]) ;;
    *) echo "Aborted." >&2; exit 1 ;;
  esac
}

report_deployment() {
  echo "Deployment triggered. Watch progress with:"
  echo "  aws ecs describe-services --cluster $ECS_CLUSTER --services $ECS_SERVICE --query 'services[0].deployments'"
}

build() {
  echo "Building $IMAGE"
  docker build --target production -t "cdny-members:$TAG" .
}

push() {
  echo "Pushing $IMAGE"
  aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$AWS_ACCOUNT.dkr.ecr.$AWS_REGION.amazonaws.com"
  docker tag "cdny-members:$TAG" "$IMAGE"
  docker push "$IMAGE"
}

deploy() {
  if ! aws ecr describe-images --repository-name cdny-members --image-ids imageTag="$TAG" >/dev/null 2>&1; then
    echo "Image $IMAGE not found in ECR - push it first (bin/release push) or run 'all'." >&2
    exit 1
  fi

  echo "Registering new task definition with image $IMAGE"
  local tmpfile
  tmpfile=$(mktemp)
  # describe-task-definition returns metadata fields register-task-definition won't accept
  aws ecs describe-task-definition --task-definition "$TASK_FAMILY" --query 'taskDefinition' \
    | jq --arg IMAGE "$IMAGE" \
      'del(.taskDefinitionArn, .revision, .status, .requiresAttributes, .compatibilities, .registeredAt, .registeredBy)
       | .containerDefinitions[0].image = $IMAGE' \
    > "$tmpfile"
  aws ecs register-task-definition --cli-input-json "file://$tmpfile"
  rm -f "$tmpfile"

  echo "Updating service"
  aws ecs update-service --cluster "$ECS_CLUSTER" --service "$ECS_SERVICE" --task-definition "$TASK_FAMILY" > /dev/null
  report_deployment
}

# Restarts the tasks on the task definition the service already has - no new
# image, no git state involved.
redeploy() {
  echo "Forcing a new deployment of the service's current task definition"
  aws ecs update-service --cluster "$ECS_CLUSTER" --service "$ECS_SERVICE" --force-new-deployment > /dev/null
  report_deployment
}

case "$COMMAND" in
  build) check_clean_tree; check_origin_master; build ;;
  push) push ;;
  deploy) check_origin_master; deploy ;;
  redeploy) redeploy ;;
  all) check_clean_tree; check_origin_master; build; push; deploy ;;
  *)
    echo "Usage: $0 [build|push|deploy|redeploy|all] [--force]" >&2
    exit 1
    ;;
esac
